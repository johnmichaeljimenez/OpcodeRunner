@ENEMY_INIT
DEFVAR ENEMY_STATE "idle" string
BREAK

@ENEMY_TICK
JUMPEQ ENEMY_STATE "idle" ENEMY_IDLE
JUMPEQ ENEMY_STATE "chase" ENEMY_CHASE
JUMPEQ ENEMY_STATE "attack" ENEMY_ATTACK
JUMP ENEMY_DONE

>ENEMY_IDLE
PRINT "ENEMY IDLE dist=[[PLAYER_DIST]]"
JUMPLE PLAYER_DIST 7 ENEMY_TO_CHASE
JUMP ENEMY_DONE

>ENEMY_TO_CHASE
SETVAR ENEMY_STATE "chase"
PRINT "ENEMY SPOTS PLAYER"
JUMP ENEMY_DONE

>ENEMY_CHASE
PRINT "ENEMY CHASE dist=[[PLAYER_DIST]]"
JUMPLE PLAYER_DIST 3 ENEMY_TO_ATTACK
JUMP ENEMY_DONE

>ENEMY_TO_ATTACK
SETVAR ENEMY_STATE "attack"
PRINT "ENEMY IN RANGE"
JUMP ENEMY_DONE

>ENEMY_ATTACK
PRINT "ENEMY ATTACK dist=[[PLAYER_DIST]]"
JUMP ENEMY_DONE

>ENEMY_DONE
BREAK