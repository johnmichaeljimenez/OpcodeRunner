<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>OpcodeRunner.Engine</PackageId>
    <Version>0.0.1</Version>
    <Authors>John Jimenez</Authors>
    <Description>Lightweight interpreted Domain Specific Language (DSL) engine for games.</Description>
    <RepositoryUrl>https://github.com/johnmichaeljimenez/OpcodeRunner</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>