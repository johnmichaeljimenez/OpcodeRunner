@_INIT

#input 1
DECVAR A 3 int
#input 2
DECVAR B 4 int

DECVAR C 0 int
DECVAR T 0 int
DECVAR STEPS 0 int

> M0
	ADD STEPS 1
	PRINT "ENTERED M0"
	JUMPEQ B 0 MH
	SUB B 1
	WAIT 1
> M1
	ADD STEPS 1
	PRINT "ENTERED M1"
	JUMPEQ A 0 M4
	SUB A 1
	WAIT 1
> M2
	ADD STEPS 1
	PRINT "ENTERED M2"
	ADD C 1
	WAIT 1
> M3
	ADD STEPS 1
	PRINT "ENTERED M3"
	ADD T 1
	WAIT 1
	JUMP M1
> M4
	ADD STEPS 1
	PRINT "ENTERED M4"
	JUMPEQ T 0 M0
	SUB T 1
	WAIT 1
> M5
	ADD STEPS 1
	PRINT "ENTERED M5"
	ADD A 1
	WAIT 1
	JUMP M4
> MH
	#same as inputs multiplied
	PRINT "ENDED:"
	PRINT "[[C]]"

	PRINT "STEPS:"
	PRINT "[[STEPS]]"